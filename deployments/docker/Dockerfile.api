# Multi-stage Dockerfile for kwall-api & GraphQL Gateway
FROM rust:1.80-bullseye AS builder

WORKDIR /usr/src/kwall
COPY . .

# Build release binary for kwall-api
RUN cargo build --release -p kwall-api

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/src/kwall/target/release/kwall-api /usr/local/bin/kwall-api

EXPOSE 8080 50051

ENTRYPOINT ["/usr/local/bin/kwall-api"]
