          "expr": "rate(kwall_ring_buffer_events_total[1m])",
          "legendFormat": "Events / sec",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Ring Buffer Dropped Events (Backpressure)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "increase(kwall_ring_buffer_events_dropped_total[1m])",
          "legendFormat": "Dropped Events / min",
          "refId": "A"
        }
      ]
    }
