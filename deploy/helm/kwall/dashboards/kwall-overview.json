{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "KWALL eBPF Dataplane & Observability Overview",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "pps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "rate(kwall_packets_total[1m])",
          "legendFormat": "Processed Packets/sec",
          "refId": "A"
        },
        {
          "expr": "rate(kwall_packets_dropped_total[1m])",
          "legendFormat": "Dropped Packets/sec",
          "refId": "B"
        }
      ],
      "title": "eBPF Packet Throughput & Drops",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "µs"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(kwall_bpf_latency_microseconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Execution Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(kwall_bpf_latency_microseconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Execution Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(kwall_bpf_latency_microseconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Execution Latency",
          "refId": "C"
        }
      ],
      "title": "Kernel Dataplane Execution Latency (P50, P95, P99)",
      "type": "timeseries"
    },
    {
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{app=\"kwall-agent\"} |= \"action\"",
          "refId": "A"
        }
      ],
      "title": "Correlated eBPF Flow & Security Logs (Loki)",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["kwall", "ebpf", "kubernetes", "security"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["1s", "5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "KWALL / Dataplane & Network Observability",
  "uid": "kwall-dataplane-overview",
  "version": 1
}
