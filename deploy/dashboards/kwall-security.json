{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "KWALL Security, DDoS & BPF LSM Runtime Violations",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(kwall_packets_dropped_total[1m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Mitigated Drops by Reason (DDoS / Blacklist / Policy)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "kwall_ringbuf_drops_total",
          "legendFormat": "Ringbuf Drops",
          "refId": "A"
        }
      ],
      "title": "eBPF Ringbuffer Drops (Backpressure)",
      "type": "stat"
    },
    {
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{app=\"kwall-agent\", severity=~\"High|Critical\"}",
          "refId": "A"
        }
      ],
      "title": "Critical LSM Security Violations (Loki)",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["kwall", "security", "lsm", "ddos"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "KWALL / Security & Threat Analytics",
  "uid": "kwall-threat-analytics",
  "version": 1
}
